    <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;strokeWidth=1;arcSize=15;" value="" vertex="1">
      <mxGeometry height="90" width="370" x="890" y="48" as="geometry" />
    </mxCell>
    <mxCell id="legend_text" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;" value="&lt;span style=&#39;font-size:8px;color:#424242;&#39;&gt;&lt;b&gt;범례 (Legend)&lt;/b&gt;&lt;br&gt;━━ 데이터/제어 흐름&amp;nbsp;&amp;nbsp;&amp;nbsp;┄┄ 모니터링/응답&lt;br&gt;&lt;span style=&#39;color:#2e7d32;&#39;&gt;■&lt;/span&gt; Digilent Pcam Pipeline&amp;nbsp;&amp;nbsp;&lt;span style=&#39;color:#1565c0;&#39;&gt;■&lt;/span&gt; PL VDMA + PS DDR&lt;br&gt;&lt;span style=&#39;color:#e65100;&#39;&gt;■&lt;/span&gt; Custom Blue Tracker&amp;nbsp;&amp;nbsp;&lt;span style=&#39;color:#c62828;&#39;&gt;■&lt;/span&gt; HDMI Output&lt;br&gt;&lt;span style=&#39;color:#4527a0;&#39;&gt;■&lt;/span&gt; Coord Path (AXI GPIO)&amp;nbsp;&amp;nbsp;&lt;span style=&#39;color:#00695c;&#39;&gt;■&lt;/span&gt; SR04 Guard&lt;br&gt;&lt;span style=&#39;color:#6a1b9a;&#39;&gt;■&lt;/span&gt; Vitis SW (PS ARM)&amp;nbsp;&amp;nbsp;&lt;span style=&#39;color:#f57f17;&#39;&gt;■&lt;/span&gt; Arduino/OpenRB-150&lt;/span&gt;" vertex="1">
      <mxGeometry height="86" width="355" x="900" y="50" as="geometry" />
    </mxCell>
    <mxCell id="files_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;strokeWidth=1;arcSize=15;" value="" vertex="1">
      <mxGeometry height="130" width="370" x="890" y="156" as="geometry" />
    </mxCell>
    <mxCell id="files_text" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;" value="&lt;span style=&#39;font-size:8px;color:#424242;&#39;&gt;&lt;b&gt;소스 파일 목록&lt;/b&gt;&lt;br&gt;&lt;b&gt;vivado/rtl/&lt;/b&gt;&lt;br&gt;&amp;nbsp;• basic_pcam_1080_axis.v (AXI4-Stream Module Reference)&lt;br&gt;&amp;nbsp;• basic_axis_blue_tracker_1080.sv (Blue Tracker Core)&lt;br&gt;&amp;nbsp;• basic_rgb_hsv_blue_classifier.sv (Tracker 내부 HSV 판정)&lt;br&gt;&amp;nbsp;• basic_sr04_guard_wrapper.v / basic_sr04_guard.sv&lt;br&gt;&lt;b&gt;vivado/block_design/&lt;/b&gt; system.bd, hw.xpr&lt;br&gt;&lt;b&gt;vivado/constraints/&lt;/b&gt; ZyboZ7_A.xdc, robot_io.xdc, timing.xdc, auto.xdc&lt;br&gt;&lt;b&gt;vitis/&lt;/b&gt; main.cc (PS ARM 소프트웨어)&lt;br&gt;&lt;b&gt;arduino/&lt;/b&gt; omx_ik_area_test.ino (OpenRB-150 IK Pick-Place)&lt;/span&gt;" vertex="1">
      <mxGeometry height="126" width="355" x="900" y="158" as="geometry" />
    </mxCell>
    <mxCell id="flow_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;strokeWidth=1;arcSize=15;" value="" vertex="1">
      <mxGeometry height="118" width="370" x="890" y="302" as="geometry" />
    </mxCell>
    <mxCell id="flow_text" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;" value="&lt;span style=&#39;font-size:8px;color:#424242;&#39;&gt;&lt;b&gt;데이터 흐름 (Data Flow)&lt;/b&gt;&lt;br&gt;❶ Pcam → D-PHY → CSI-2 → BayerToRGB → Gamma&lt;br&gt;❷ → PL VDMA S2MM → PS HP/DDR Ctrl → DDR3 → PL VDMA MM2S&lt;br&gt;❸ → basic_pcam_1080_axis → tracker 내부 HSV/BBox/Stable/OSD&lt;br&gt;❹ → AXI4-S Video Out (+ VTG timing) → rgb2dvi → HDMI&lt;br&gt;❺ coord_word → GPIO CH1 → PS Read; PS → CH2 → coord_select&lt;br&gt;❻ SW0 + HC-SR04 → PL Guard → AXI GPIO → PS Read&lt;br&gt;❼ Vitis: 안정된 최대 6개 중 min Y → min X 선택&lt;br&gt;❽ UART TARGET → OpenRB 검증 → ACK 즉시 응답&lt;br&gt;❾ ACK 후 IK + Pick-Place + DYNAMIXEL 제어&lt;br&gt;❿ Vitis: RC카 출발/재도착 대기 → Seq++ → 다음 좌표&lt;/span&gt;" vertex="1">
      <mxGeometry height="114" width="355" x="900" y="304" as="geometry" />
    </mxCell>
    <mxCell id="proto_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;strokeWidth=1;arcSize=15;" value="" vertex="1">
      <mxGeometry height="96" width="370" x="890" y="428" as="geometry" />
    </mxCell>
    <mxCell id="proto_text" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;" value="&lt;span style=&#39;font-size:8px;color:#424242;&#39;&gt;&lt;b&gt;UART 프로토콜 (115200, 8-N-1, CRC-8 Poly 0x07)&lt;/b&gt;&lt;br&gt;&lt;b&gt;TARGET (9 byte):&lt;/b&gt; [AA] [55] [01] [Seq] [X_L] [X_H] [Y_L] [Y_H] [CRC8]&lt;br&gt;&lt;b&gt;ACK (5 byte):&lt;/b&gt; [AA] [55] [02] [Seq] [CRC8]&lt;br&gt;• Seq: 송신 시퀀스 번호 (0~255)&lt;br&gt;• X: 0~1920 (side), Y: 0~1080 (depth) AREA 좌표&lt;br&gt;• ACK는 유효 TARGET 수신 확인이며 로봇 동작 성공 신호가 아님&lt;br&gt;• ACK 미수신 시 100ms 후 재전송 (3회마다 900ms 대기)&lt;/span&gt;" vertex="1">
      <mxGeometry height="88" width="355" x="900" y="432" as="geometry" />
    </mxCell>
    <mxCell id="zybo_boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;dashPattern=8 4;arcSize=4;" value="" vertex="1">
      <mxGeometry height="240" width="860" x="10" y="38" as="geometry" />
    </mxCell>
